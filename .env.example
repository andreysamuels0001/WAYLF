# Copy to .env.local and fill in. .env.local is gitignored.

# Signs and encrypts quiz result tokens (AES-256-GCM). Any passphrase of 16+
# characters. Without it the app falls back to a public development key, which
# means share links are forgeable — set this before deploying.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
QUIZ_SECRET=

# Nothing else is required. The character deck comes from AniList's public API
# via `npm run deck`, which needs no credentials.
